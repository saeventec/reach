# Example settings for Reach.
#
# How to use it: "task setup" copies this file to ".env" if you don't have one.
# The real ".env" file is ignored by git, so secrets never reach the public repo.
# Docker Compose reads ".env" automatically and fills in ${...} in compose.yaml.

# The password of the Postgres database. Only used on your own computer.
# Use letters and digits only: it is also put inside a URL in compose.yaml,
# where symbols like @ or / would break it.
POSTGRES_PASSWORD=localdevpassword
