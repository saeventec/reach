# Files git must never save.
# Each pattern below matches files or folders by name.
# Learn more: docs/learn/gitignore.md

# Secrets and local settings: the repo is public.
.env

# Operating system files
.DS_Store
Thumbs.db

# Editor files (we keep .vscode/extensions.json, which is shared on purpose)
.idea/
.vscode/*
!.vscode/extensions.json

# Build output and downloaded dependencies
bin/
dist/
node_modules/

# Playwright's output: traces and screenshots of failed end-to-end tests,
# and its HTML report. Learn more: docs/learn/playwright.md
test-results/
playwright-report/
