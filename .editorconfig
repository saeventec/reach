# Basic editor settings that every editor understands.
# Learn more: docs/learn/editorconfig.md

# This is the top-level file: don't look for others in parent folders.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Go's formatter (gofmt) indents with tabs.
[*.go]
indent_style = tab

# Caddy's own formatter ("caddy fmt") indents the Caddyfile with tabs.
[Caddyfile]
indent_style = tab
